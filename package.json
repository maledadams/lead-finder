{
  "name": "lead-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent, deduplicating prospecting system. Finds businesses, scores them, drafts the outreach, and waits for you to approve it. Runs on Cloudflare.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create lead-finder",
    "db:init": "wrangler d1 execute lead-finder --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute lead-finder --local --file=./schema.sql",
    "db:console": "wrangler d1 execute lead-finder --remote --command",
    "tail": "wrangler tail",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs",
    "dev:test": "wrangler dev --local --port 8787 --var REQUIRE_ACCESS:false --var SESSION_SECRET:local-browser-test-secret-value"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "marked": "^18.0.12"
  },
  "packageManager": "pnpm@11.24.0"
}
